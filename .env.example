# ARTHUR MVP — example environment file.
# Copy to .env and adjust. The MVP runs fully on SQLite; nothing here is required.

# Demo mode: rule-based planner, no LLM key needed. Set to "false" to use a real LLM.
DEMO_MODE=true

# Name used to seed the owner (Admin) account on first run.
ARTHUR_OWNER_NAME=Mohammed Farhan

# --- Paths (uncomment to override defaults) ---
# ARTHUR_HOME=/home/user/arthur-ai
# ARTHUR_DB_PATH=/home/user/arthur-ai/data/arthur.db

# --- Real LLM (uncomment to enable; requires DEMO_MODE=false) ---
# ARTHUR_LLM_BASE_URL=https://api.openai.com/v1
# ARTHUR_LLM_API_KEY=sk-...
# ARTHUR_LLM_MODEL=gpt-4o-mini

# --- Security (recommended for any network-exposed deployment) ---
# Master key for Fernet-encrypted secrets at rest (base64url, 32 bytes).
# If unset, a key is generated once and stored at $ARTHUR_HOME/.arthur_secret (600).
# ARTHUR_SECRET_KEY=
# Require login (bcrypt passwords + session tokens) for /api/*.
# Default: false in DEMO_MODE, true otherwise.
# ARTHUR_REQUIRE_AUTH=
# Initial owner password for headless setups (used once, then unset it).
# ARTHUR_OWNER_PASSWORD=
# Session lifetime in hours.
# ARTHUR_SESSION_HOURS=24
# Comma-separated origins allowed to call the API (dashboard/mobile).
# ARTHUR_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Hosts agents/services may POST user data to (default-deny everything else).
# The LLM provider host is added automatically from ARTHUR_LLM_BASE_URL.
# ARTHUR_EGRESS_ALLOWLIST=html.duckduckgo.com,duckduckgo.com,exp.host,exponent.dev
